{
 "cases": [
  {
   "cmd": "\"$BIN\" in.txt out.txt && cat out.txt",
   "setup": "printf 'Hello\\n' > in.txt",
   "stdout": "Uryyb\n"
  },
  {
   "cmd": "\"$BIN\" in.txt out.txt && cat out.txt",
   "setup": "printf 'Hello, World!\n' > in.txt",
   "stdout": "Uryyb, Jbeyq!\n"
  },
  {
   "cmd": "\"$BIN\" in.txt out.txt && cat out.txt",
   "setup": "printf 'abcdefghijklmnopqrstuvwxyz\n' > in.txt",
   "stdout": "nopqrstuvwxyzabcdefghijklm\n"
  },
  {
   "cmd": "\"$BIN\" in.txt out.txt && cat out.txt",
   "setup": "printf 'ABCXYZ 123\n' > in.txt",
   "stdout": "NOPKLM 123\n"
  },
  {
   "cmd": "\"$BIN\" in.txt out.txt && cat out.txt",
   "setup": "printf '' > in.txt",
   "stdout": ""
  },
  {
   "cmd": "\"$BIN\" in.txt out.txt && cat out.txt",
   "setup": "printf 'line one\nline two\n' > in.txt",
   "stdout": "yvar bar\nyvar gjb\n"
  },
  {
   "name": "twice gives the original",
   "cmd": "\"$BIN\" in.txt mid.txt && \"$BIN\" mid.txt out.txt && cat out.txt",
   "setup": "echo 'Secret message' > in.txt",
   "stdout": "Secret message\n"
  },
  {
   "cmd": "\"$BIN\" nope out.txt 2>&1; echo \"rc=$?\"",
   "stdout": "cannot open nope\nrc=1\n"
  },
  {
   "cmd": "\"$BIN\" in.txt no/dir/out.txt; echo \"rc=$?\"",
   "setup": "echo x > in.txt",
   "stdout": "rc=2\n"
  }
 ]
}
