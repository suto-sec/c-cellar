{
 "cases": [
  {
   "args": [
    "f.txt"
   ],
   "setup": "printf 'a\\nb\\n' > f.txt",
   "stdout": "a\nb\n"
  },
  {
   "args": [
    "f"
   ],
   "setup": "printf 'hello\\nworld\\n' > f",
   "stdout": "hello\nworld\n"
  },
  {
   "args": [
    "f"
   ],
   "setup": ": > f",
   "stdout": ""
  },
  {
   "cmd": "\"$BIN\" f | cmp - g && echo same",
   "setup": "seq 1 3000 > f; seq 1 3000 > g",
   "stdout": "same\n"
  },
  {
   "cmd": "\"$BIN\" nope 2>&1; echo \"rc=$?\"",
   "stdout": "nope: No such file or directory\nrc=1\n"
  }
 ]
}
