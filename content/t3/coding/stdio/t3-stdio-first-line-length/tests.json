   ],
   "setup": "printf 'hello\\nworld\\n' > f.txt",
   "stdout": "position: 6\n"
  },
  {
   "name": "a short first line",
   "args": [
    "f.txt"
   ],
   "setup": "printf 'a\\nlong second line\\n' > f.txt",
   "stdout": "position: 2\n"
  },
  {
   "name": "an empty first line",
   "args": [
    "f.txt"
   ],
   "setup": "printf '\\nx\\n' > f.txt",
   "stdout": "position: 1\n"
  },
  {
   "name": "no newline at all",
   "args": [
    "f.txt"
   ],
   "setup": "printf 'abcdefg' > f.txt",
   "stdout": "position: 7\n"
  },
  {
   "name": "empty file",
   "args": [
    "f.txt"
   ],
   "setup": ": > f.txt",
